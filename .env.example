# Copy to .env and fill in. NEVER commit .env -- it is gitignored.
# Every value below is read at runtime; nothing is hard-coded in the source.

# --- Google Cloud ---
GCP_PROJECT_ID="your-project-id"
GCP_REGION="us-central1"
SERVICE_PREFIX="csuite"
ARTIFACT_REPO="csuite"
RUNTIME_SA_NAME="csuite-runtime"
# IMAGE_TAG defaults to the short git SHA.
# IMAGE_TAG=""

# --- Model ---
MODEL_NAME="gemini-3.6-flash"
MODEL_TEMPERATURE="0.2"
MODEL_MAX_OUTPUT_TOKENS="4096"

# --- Secrets ---
# The NAME of the Secret Manager secret. The value never appears in this file
# or anywhere in the repository. Create it once:
#   gcloud secrets create GEMINI_API_KEY --replication-policy=automatic
#   printf '%s' 'YOUR_KEY' | gcloud secrets versions add GEMINI_API_KEY --data-file=-
GEMINI_API_KEY_SECRET="GEMINI_API_KEY"

# LOCAL DEVELOPMENT ONLY. Leave empty for any deployment -- Cloud Run injects
# the value from Secret Manager. Uncomment only to run ./deploy/run_local.sh.
# GEMINI_API_KEY=""

# --- Executive agents ---
ACTIVE_ROLES_CSV="cfo,cso,cmo,chro,cto"
AGENT_MEMORY="512Mi"
AGENT_CPU="1"
AGENT_TIMEOUT="300"
AGENT_MIN_INSTANCES="0"
AGENT_MAX_INSTANCES="4"

# --- Orchestrator ---
ORCHESTRATOR_MEMORY="1Gi"
ORCHESTRATOR_CPU="1"
ORCHESTRATOR_TIMEOUT="3600"
ORCHESTRATOR_MIN_INSTANCES="1"
AGENT_TIMEOUT_SECONDS="120"
AGENT_MAX_RETRIES="2"

# --- Human in the loop ---
HITL_ENABLED="true"
# Findings below this confidence are held for a human.
HITL_CONFIDENCE_FLOOR="0.75"
# Findings with no citation into the source document are always held.
HITL_REQUIRE_CITATIONS="true"
# Require explicit human sign-off on the final recommendation.
HITL_FINAL_SIGNOFF="true"
HITL_TIMEOUT_SECONDS="900"

# --- Decision log ---
# memory    = in-process, no external dependency (recommended for a live demo)
# firestore = persisted for post-demo inspection
DECISION_LOG_BACKEND="memory"
FIRESTORE_COLLECTION="csuite_decision_log"

# --- Uploads ---
MAX_UPLOAD_BYTES="1048576"
ALLOWED_UPLOAD_EXTENSIONS_CSV=".md,.markdown,.txt,.csv"

# --- Local development ---
LOG_LEVEL="INFO"
LOCAL_AGENT_BASE_PORT="8101"
LOCAL_ORCHESTRATOR_PORT="8080"
